# APP CONFIGURATION
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Orchard"

# DATABASE (PostgreSQL & Redis)
DATABASE_URL="postgresql://postgres:password@localhost:5432/orchard_db?schema=public"
REDIS_URL="redis://localhost:6379"

# AUTHENTICATION & SECURITY
JWT_SECRET="orchard_super_secret_jwt_key_change_in_production_32chars_min"
JWT_REFRESH_SECRET="orchard_super_secret_refresh_key_change_in_production"
JWT_EXPIRES_IN="7d"
COOKIE_DOMAIN="localhost"

# PAYMENT GATEWAY (Razorpay)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# MEDIA STORAGE (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# TRANSACTIONAL EMAIL (Nodemailer / SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="Orchard Store <noreply@orchard.com>"

# ADMIN SEEDING CREDENTIALS
ADMIN_EMAIL="admin@orchard.com"
ADMIN_PASSWORD="AdminPassword123!"
